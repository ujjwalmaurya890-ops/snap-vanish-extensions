# Snap Vanish — Optional Cloud Sync & Billing Configuration
# Local extension & web studio functionality works 100% offline without these variables.
# Never commit real API keys or service-role secrets to version control.

# Optional: Supabase project URL and anonymous public key (RLS enforced on server)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Trusted server-side checkout and billing portal URLs
VITE_BILLING_CHECKOUT_URL=
VITE_BILLING_PORTAL_URL=
