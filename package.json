{
  "name": "snap-vanish-extension",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "build": "vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vite-node scripts/bench-dust.mts",
    "verify": "tsc --noEmit && vitest run && node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.66.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vitest": "^5.0.5"
  }
}
